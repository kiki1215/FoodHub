# ==============================================================================
# FOODHUB - FILE CẤU HÌNH MÔI TRƯỜNG MẪU (.env.example)
# ==============================================================================
# Hướng dẫn:
#   1. Sao chép file này thành ".env" ở thư mục gốc dự án.
#   2. Thay thế các giá trị mẫu (đặc biệt mật khẩu và JWT_SECRET) trước khi chạy.
#   3. KHÔNG BAO GIỜ commit file ".env" lên Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH CHUNG & MÚI GIỜ
# ------------------------------------------------------------------------------
APP_NAME=FOODHUB
APP_ENV=development
TZ=Asia/Ho_Chi_Minh

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH MYSQL SERVER (1 Server - 5 Database Logic)
# ------------------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_DOCKER_HOST=mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=change_me_root_password

# Tên 5 database độc lập theo nguyên tắc Database-per-Service
USER_DB_NAME=user_db
MENU_DB_NAME=menu_db
CART_DB_NAME=cart_db
ORDER_DB_NAME=order_db
AI_DB_NAME=ai_db

# Tài khoản MySQL riêng cho từng Microservice (khớp với database/init.sql)
USER_DB_USER=user_svc
USER_DB_PASSWORD=user_svc_pass_dev

MENU_DB_USER=menu_svc
MENU_DB_PASSWORD=menu_svc_pass_dev

CART_DB_USER=cart_svc
CART_DB_PASSWORD=cart_svc_pass_dev

ORDER_DB_USER=order_svc
ORDER_DB_PASSWORD=order_svc_pass_dev

AI_DB_USER=ai_svc
AI_DB_PASSWORD=ai_svc_pass_dev

# ------------------------------------------------------------------------------
# 3. BẢO MẬT & JWT (CHỈ DÙNG GIÁ TRỊ MẪU - PHẢI ĐỔI KHI CHẠY THẬT)
# ------------------------------------------------------------------------------
# Khóa bí mật JWT (tối thiểu 256-bit / 32 ký tự cho HS256)
JWT_SECRET=replace_this_with_a_secure_random_256bit_secret_key_for_foodhub
JWT_EXPIRATION_MS=86400000

# Tài khoản Admin mẫu khởi tạo ban đầu (chỉ dùng cho môi trường dev/demo)
DEFAULT_ADMIN_EMAIL=admin@foodhub.local
DEFAULT_ADMIN_PASSWORD=Admin@123456_change_me
DEFAULT_ADMIN_NAME=Quản trị viên FOODHUB

# ------------------------------------------------------------------------------
# 4. CỔNG CHẠY CÁC DỊCH VỤ (THỐNG NHẤT TOÀN DỰ ÁN)
# ------------------------------------------------------------------------------
FRONTEND_PORT=5173
FRONTEND_DOCKER_PORT=3000
API_GATEWAY_PORT=8080
USER_SERVICE_PORT=8081
MENU_SERVICE_PORT=8082
CART_SERVICE_PORT=8083
ORDER_SERVICE_PORT=8084
AI_SERVICE_PORT=8000

# ------------------------------------------------------------------------------
# 5. URL KẾT NỐI GIỮA CÁC MICROSERVICES (KHÔNG DÙNG EUREKA/CONSUL)
# ------------------------------------------------------------------------------
# Khi chạy local trực tiếp trên máy host: dùng http://localhost:<PORT>
# Khi chạy trong Docker Compose network: dùng http://<service-name>:<PORT>
USER_SERVICE_URL=http://localhost:8081
MENU_SERVICE_URL=http://localhost:8082
CART_SERVICE_URL=http://localhost:8083
ORDER_SERVICE_URL=http://localhost:8084
AI_SERVICE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 6. CẤU HÌNH FRONTEND (VITE + REACT)
# ------------------------------------------------------------------------------
# Frontend chỉ giao tiếp với Backend thông qua API Gateway
VITE_API_BASE_URL=http://localhost:8080/api
VITE_APP_TITLE=FOODHUB - Đặt Đồ Ăn Trực Tuyến
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 7. CẤU HÌNH AI SERVICE (FASTAPI + SCIKIT-LEARN)
# ------------------------------------------------------------------------------
AI_SERVICE_ENV=development
AI_LOG_LEVEL=info
AI_RECOMMENDATION_LIMIT=6
AI_MODEL_RETRAIN_INTERVAL_MINUTES=60
